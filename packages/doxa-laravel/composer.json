{
    "name": "doxa/laravel-sdk",
    "description": "Doxa OIDC relying-party SDK for Laravel",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-openssl": "*",
        "ext-json": "*",
        "firebase/php-jwt": "^7.1",
        "guzzlehttp/guzzle": "^7.8.2",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0",
        "illuminate/cache": "^10.0 || ^11.0 || ^12.0",
        "illuminate/session": "^10.0 || ^11.0 || ^12.0",
        "illuminate/encryption": "^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0",
        "symfony/http-foundation": "^6.4 || ^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.5 || ^11.5",
        "laravel/pint": "^1.30",
        "phpstan/phpstan": "^2.1",
        "symfony/process": "^6.4 || ^7.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0",
        "illuminate/filesystem": "^10.0 || ^11.0 || ^12.0"
    },
    "autoload": { "psr-4": { "Doxa\\Laravel\\": "src/" } },
    "autoload-dev": { "psr-4": { "Doxa\\Laravel\\Tests\\": "tests/" } },
    "extra": { "laravel": { "providers": ["Doxa\\Laravel\\DoxaServiceProvider"] } },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint",
        "check-format": "pint --test"
    },
    "config": { "sort-packages": true, "allow-plugins": false }
}
